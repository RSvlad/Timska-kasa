{
  "name": "timska-kasa",
  "private": true,
  "version": "0.0.1",
  "description": "Апликација за вођење заједничке касе тима или организације — Firebase + React, без бекенда.",
  "license": "MIT",
  "author": "RSvlad",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RSvlad/Timska-kasa.git"
  },
  "homepage": "https://rsvlad.github.io/Timska-kasa/",
  "bugs": {
    "url": "https://github.com/RSvlad/Timska-kasa/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-timska-kasa \"vitest run --config vitest.rules.config.ts\"",
    "deploy": "npm run lint && npm test && npm run build && gh-pages -d dist"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.32.1",
    "gh-pages": "^6.3.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html,yml,yaml}": "prettier --write"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  },
  "allowScripts": {
    "@firebase/util": false,
    "protobufjs": false
  }
}
