{
  "name": "timska-kasa",
  "private": true,
  "version": "0.0.1",
  "description": "Апликација за вођење заједничке касе тима или организације — Firebase + React, без бекенда.",
  "license": "MIT",
  "author": "RSvlad",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RSvlad/Timska-kasa.git"
  },
  "homepage": "https://rsvlad.github.io/Timska-kasa/",
  "bugs": {
    "url": "https://github.com/RSvlad/Timska-kasa/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "deploy": "npm run lint && npm test && npm run build && gh-pages -d dist"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gh-pages": "^6.3.0",
    "globals": "^17.13.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.2.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  },
  "allowScripts": {
    "@firebase/util": false,
    "protobufjs": false
  }
}
