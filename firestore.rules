rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // allowedUsers doc ID-јеви су email-ови малим словима.
    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAllowed() {
      return isVerified()
        && exists(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email.lower()));
    }

    // Један get уместо exists + get.
    function isAdmin() {
      return isVerified()
        && get(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email.lower())).data.role == "Admin";
    }

    match /allowedUsers/{email} {
      allow read: if isVerified() && request.auth.token.email.lower() == email;
      allow write: if false;
    }

    match /categories/{categoryId} {
      allow read: if isAllowed();
      allow create: if isAdmin();
      allow update: if isAdmin()
        && (
          !resource.data.system
          || (
            request.resource.data.name   == resource.data.name
            && request.resource.data.type   == resource.data.type
            && request.resource.data.active == resource.data.active
          )
        );
      allow delete: if false;
    }

    match /funds/{fundId} {
      allow read: if isAllowed();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /transactions/{recordId} {
      allow read: if isAllowed();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

  }
}