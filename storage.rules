rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // allowedUsers doc ID-јеви су email-ови малим словима.
    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAllowed() {
      return isVerified()
        && firestore.exists(/databases/(default)/documents/allowedUsers/$(request.auth.token.email.lower()));
    }

    // Један cross-service get уместо exists + get.
    function isAdmin() {
      return isVerified()
        && firestore.get(/databases/(default)/documents/allowedUsers/$(request.auth.token.email.lower())).data.role == "Admin";
    }

    // Путања: receipts/{recordId}/{filename} — видети ReceiptStorage.ts.
    // Само Admin отпрема/брише; сви allowed корисници читају (исто као /transactions у firestore.rules).
    match /receipts/{recordId}/{fileName} {
      allow read: if isAllowed();
      allow write: if isAdmin()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches("image/(jpeg|png|webp|heic)");
      allow delete: if isAdmin();
    }

  }
}
